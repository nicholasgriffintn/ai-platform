{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Keep Babel on 7 until babel-plugin-react-compiler supports Babel 8; under Babel 8 the compiler silently skips components that destructure props with defaults",
      "matchPackageNames": ["@babel/core", "@babel/preset-typescript"],
      "allowedVersions": "<8"
    },
    {
      "description": "Require review for release tooling",
      "matchPackageNames": ["@changesets/cli"],
      "automerge": false
    },
    {
      "description": "Automerge devDependencies",
      "matchDepTypes": ["devDependencies"],
      "excludePackageNames": ["@changesets/cli"],
      "abandonmentThreshold": "1 year",
      "minimumReleaseAge": "7 days",
      "automerge": true
    },
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": ["minor", "patch"],
      "excludePackageNames": ["@changesets/cli"],
      "abandonmentThreshold": "1 year",
      "minimumReleaseAge": "7 days",
      "automerge": true
    }
  ]
}
