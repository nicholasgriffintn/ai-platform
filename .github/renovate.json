{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true
	},
	"packageRules": [
		{
			"description": "Require review for release tooling",
			"matchPackageNames": [
				"@changesets/cli"
			],
			"automerge": false
		},
		{
			"description": "Automerge devDependencies",
			"matchDepTypes": [
				"devDependencies"
			],
			"excludePackageNames": [
				"@changesets/cli"
			],
			"abandonmentThreshold": "1 year",
			"minimumReleaseAge": "7 days",
			"automerge": true
		},
		{
			"description": "Automerge non-major updates",
			"matchUpdateTypes": [
				"minor",
				"patch"
			],
			"excludePackageNames": [
				"@changesets/cli"
			],
			"abandonmentThreshold": "1 year",
			"minimumReleaseAge": "7 days",
			"automerge": true
		}
	]
}
