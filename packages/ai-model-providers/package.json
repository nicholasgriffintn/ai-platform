{
  "name": "@ngriffin_uk/polychat-ai-model-providers",
  "version": "0.1.0",
  "description": "Model provider adapters for Polychat: capability manifests plus trainers, hosts and connection checks for Hugging Face, AWS, Together, Fireworks, Nebius, Google Vertex, Azure, RunPod, Cloudflare Workers AI and self-hosted OpenAI-compatible servers",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "polychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ngriffin_uk/polychat-ai-providers": "workspace:^",
    "@ngriffin_uk/polychat-schemas": "workspace:^",
    "@ngriffin_uk/polychat-utility-core": "workspace:^",
    "@ngriffin_uk/polychat-utility-server": "workspace:^",
    "aws4fetch": "1.0.20"
  },
  "devDependencies": {
    "@ngriffin_uk/polychat-config": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
