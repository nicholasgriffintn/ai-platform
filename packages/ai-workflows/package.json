{
  "name": "@ngriffin_uk/polychat-ai-workflows",
  "version": "0.1.0",
  "description": "Workflow primitives for Polychat hosts: declare queued tasks with on(), self-rescheduling pollers with poll(), cron jobs with every(), and let the host wire the queue and the cron trigger once",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "polychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ngriffin_uk/polychat-ai-telemetry": "workspace:^",
    "@ngriffin_uk/polychat-library-tasks": "workspace:^",
    "@ngriffin_uk/polychat-utility-server": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ngriffin_uk/polychat-config": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
