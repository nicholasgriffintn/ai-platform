{
  "extends": "@ngriffin_uk/polychat-config/tsconfig/library",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.typecheck.tsbuildinfo"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__test__/**/*",
    "src/**/__tests__/**/*",
    "src/test/**/*",
    "src/test-setup.ts",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.json"
    },
    {
      "path": "../ai-telemetry"
    },
    {
      "path": "../library-tasks"
    },
    {
      "path": "../utility-server"
    }
  ]
}
