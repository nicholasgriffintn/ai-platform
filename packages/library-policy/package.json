{
  "name": "@ngriffin_uk/polychat-library-policy",
  "version": "0.5.0",
  "description": "Cedar policy evaluation and shared authorisation contracts for Polychat runtimes",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "polychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "workerd": "./dist/runtime-worker.js",
      "types": "./dist/runtime-node.d.ts",
      "import": "./dist/runtime-node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:runtime": "node scripts/build-runtime.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b tsconfig.typecheck.json"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.14.0"
  },
  "devDependencies": {
    "@ngriffin_uk/polychat-config": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
