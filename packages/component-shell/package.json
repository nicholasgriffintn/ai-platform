{
  "name": "@ngriffin_uk/polychat-component-shell",
  "version": "0.2.0",
  "description": "Connected navigation shell shared by the Polychat web and desktop apps",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "polychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./discover-bands": {
      "polychat-source": "./src/Discover/DiscoverBands.tsx",
      "types": "./dist/Discover/DiscoverBands.d.ts",
      "import": "./dist/Discover/DiscoverBands.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ngriffin_uk/polychat-component-account": "workspace:^",
    "@ngriffin_uk/polychat-component-capabilities": "workspace:^",
    "@ngriffin_uk/polychat-component-content": "workspace:^",
    "@ngriffin_uk/polychat-component-conversation": "workspace:^",
    "@ngriffin_uk/polychat-component-experiences": "workspace:^",
    "@ngriffin_uk/polychat-component-models": "workspace:^",
    "@ngriffin_uk/polychat-component-navigation": "workspace:^",
    "@ngriffin_uk/polychat-component-ui": "workspace:^",
    "@ngriffin_uk/polychat-component-workspaces": "workspace:^",
    "@ngriffin_uk/polychat-library-chat": "workspace:^",
    "@ngriffin_uk/polychat-library-client": "workspace:^",
    "@ngriffin_uk/polychat-library-react": "workspace:^",
    "@ngriffin_uk/polychat-library-realtime": "workspace:^",
    "@ngriffin_uk/polychat-schemas": "workspace:^",
    "@ngriffin_uk/polychat-utility-core": "workspace:^",
    "@ngriffin_uk/polychat-utility-react": "workspace:^",
    "lucide-react": "1.39.0"
  },
  "devDependencies": {
    "@ngriffin_uk/polychat-config": "workspace:^",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "8.2.2",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "*",
    "react": "catalog:react-peer",
    "react-dom": "catalog:react-peer",
    "react-router": "*",
    "sonner": "*",
    "zustand": "*"
  }
}
