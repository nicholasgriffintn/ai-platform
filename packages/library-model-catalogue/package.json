{
  "name": "@ngriffin_uk/polychat-library-model-catalogue",
  "version": "0.1.0",
  "description": "The Polychat model catalogue: families and provider offerings as data, the schema that resolves them into model configs, and the models.dev sync that maintains them",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "polychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resolved": {
      "types": "./dist/resolved.d.ts",
      "import": "./dist/resolved.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "models:sync": "node ./scripts/sync-models-dev.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ngriffin_uk/polychat-schemas": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ngriffin_uk/polychat-config": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
