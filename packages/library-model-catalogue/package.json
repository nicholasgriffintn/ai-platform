{
  "name": "@ngriffin_uk/polychat-library-model-catalogue",
  "version": "0.7.0",
  "description": "The Polychat model catalogue: families and provider offerings as data, and the schema that resolves them into model configs",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "polychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resolved": {
      "types": "./dist/resolved.d.ts",
      "import": "./dist/resolved.js"
    },
    "./schema": {
      "polychat-source": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./files": {
      "polychat-source": "./src/files.ts",
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@ngriffin_uk/polychat-schemas": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ngriffin_uk/polychat-config": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
