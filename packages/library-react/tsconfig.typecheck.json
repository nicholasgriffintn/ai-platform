{
  "extends": "@ngriffin_uk/polychat-config/tsconfig/react-library",
  "compilerOptions": {
    "types": ["vite/client"],
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.typecheck.tsbuildinfo"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__test__/**/*",
    "src/**/__tests__/**/*",
    "src/test/**/*",
    "src/test-setup.ts",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.json"
    },
    {
      "path": "../library-chat"
    },
    {
      "path": "../library-client"
    },
    {
      "path": "../library-flags"
    },
    {
      "path": "../library-realtime"
    },
    {
      "path": "../library-sites"
    },
    {
      "path": "../library-surface"
    },
    {
      "path": "../schemas"
    },
    {
      "path": "../utility-core"
    },
    {
      "path": "../utility-react"
    }
  ]
}
