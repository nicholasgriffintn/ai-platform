{
  "name": "@ngriffin_uk/polychat-library-react",
  "version": "0.1.0",
  "description": "React providers and query controllers for Polychat",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "polychat-source": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./conversation-cache": {
      "polychat-source": "./src/conversation-cache.ts",
      "types": "./dist/conversation-cache.d.ts",
      "import": "./dist/conversation-cache.js",
      "require": "./dist/conversation-cache.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:package": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ngriffin_uk/polychat-library-chat": "workspace:^",
    "@ngriffin_uk/polychat-library-client": "workspace:^",
    "@ngriffin_uk/polychat-library-surface": "workspace:^"
  },
  "devDependencies": {
    "@ngriffin_uk/polychat-config": "workspace:^",
    "@tanstack/react-query": "5.102.7",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
