{
  "extends": "@ngriffin_uk/polychat-config/tsconfig/library",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__test__/**/*",
    "src/**/__tests__/**/*",
    "src/test/**/*",
    "src/test-setup.ts"
  ],
  "references": []
}
