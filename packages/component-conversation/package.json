{
  "name": "@ngriffin_uk/polychat-component-conversation",
  "version": "1.0.0",
  "description": "Controlled conversation timeline, message, and composer views for Polychat surfaces",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src/styles.css"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "polychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./keyboard-shortcuts-help": {
      "polychat-source": "./src/KeyboardShortcutsHelp.tsx",
      "types": "./dist/KeyboardShortcutsHelp.d.ts",
      "import": "./dist/KeyboardShortcutsHelp.js"
    },
    "./styles.css": {
      "polychat-source": "./src/styles.css",
      "style": "./src/styles.css",
      "default": "./dist/index.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ngriffin_uk/polychat-component-content": "workspace:^",
    "@ngriffin_uk/polychat-component-experiences": "workspace:^",
    "@ngriffin_uk/polychat-component-models": "workspace:^",
    "@ngriffin_uk/polychat-component-navigation": "workspace:^",
    "@ngriffin_uk/polychat-component-ui": "workspace:^",
    "@ngriffin_uk/polychat-library-chat": "workspace:^",
    "@ngriffin_uk/polychat-library-client": "workspace:^",
    "@ngriffin_uk/polychat-library-react": "workspace:^",
    "@ngriffin_uk/polychat-library-realtime": "workspace:^",
    "@ngriffin_uk/polychat-schemas": "workspace:^",
    "@ngriffin_uk/polychat-utility-core": "workspace:^",
    "@ngriffin_uk/polychat-utility-react": "workspace:^",
    "lucide-react": "1.38.0",
    "sonner": "2.0.8",
    "virtua": "0.50.6"
  },
  "devDependencies": {
    "@ngriffin_uk/polychat-config": "workspace:^",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "8.2.2",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "*",
    "react": "catalog:react-peer",
    "react-dom": "catalog:react-peer",
    "react-router": "*",
    "sonner": "*",
    "zustand": "*"
  }
}
