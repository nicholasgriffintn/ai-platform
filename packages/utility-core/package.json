{
  "name": "@ngriffin_uk/polychat-utility-core",
  "version": "0.1.0",
  "description": "Dependency-light utility functions shared by Polychat React surfaces",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "polychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@ngriffin_uk/polychat-config": "workspace:^",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
