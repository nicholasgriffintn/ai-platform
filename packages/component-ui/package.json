{
  "name": "@ngriffin_uk/polychat-component-ui",
  "version": "0.1.0",
  "description": "Accessible React DOM controls and layout primitives for Polychat surfaces",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src/styles.css"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "polychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "polychat-source": "./src/styles.css",
      "style": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && vite build --config vite.styles.config.ts",
    "check": "pnpm lint && pnpm format:check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "pnpm oxlint",
    "test": "vitest run",
    "test:package": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ngriffin_uk/polychat-utility-core": "workspace:^",
    "@ngriffin_uk/polychat-utility-react": "workspace:^",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next-themes": "0.4.6",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@ngriffin_uk/polychat-config": "workspace:^",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "4.3.3",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "8.2.1",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react-peer",
    "react-dom": "catalog:react-peer"
  }
}
