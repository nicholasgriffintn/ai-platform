{
  "name": "@ngriffin_uk/polychat-schemas",
  "version": "1.1.0",
  "private": false,
  "description": "Validated wire contracts and product schemas shared across Polychat runtimes",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "polychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./analytics": {
      "polychat-source": "./src/analytics.ts",
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js"
    },
    "./chat-stream": {
      "polychat-source": "./src/chat-stream.ts",
      "types": "./dist/chat-stream.d.ts",
      "import": "./dist/chat-stream.js"
    },
    "./compaction-status": {
      "polychat-source": "./src/compaction-status.ts",
      "types": "./dist/compaction-status.d.ts",
      "import": "./dist/compaction-status.js"
    },
    "./conversation-replacement": {
      "polychat-source": "./src/conversation-replacement.ts",
      "types": "./dist/conversation-replacement.d.ts",
      "import": "./dist/conversation-replacement.js"
    },
    "./experiences": {
      "polychat-source": "./src/experiences.ts",
      "types": "./dist/experiences.d.ts",
      "import": "./dist/experiences.js"
    },
    "./goals": {
      "polychat-source": "./src/goals.ts",
      "types": "./dist/goals.d.ts",
      "import": "./dist/goals.js"
    },
    "./message-part-utils": {
      "polychat-source": "./src/message-part-utils.ts",
      "types": "./dist/message-part-utils.d.ts",
      "import": "./dist/message-part-utils.js"
    },
    "./provider-messages": {
      "polychat-source": "./src/provider-messages.ts",
      "types": "./dist/provider-messages.d.ts",
      "import": "./dist/provider-messages.js"
    },
    "./sandbox-constants": {
      "polychat-source": "./src/sandbox-constants.ts",
      "types": "./dist/sandbox-constants.d.ts",
      "import": "./dist/sandbox-constants.js"
    },
    "./tool-ids": {
      "polychat-source": "./src/tool-ids.ts",
      "types": "./dist/tool-ids.d.ts",
      "import": "./dist/tool-ids.js"
    },
    "./user-profile": {
      "polychat-source": "./src/user-profile.ts",
      "types": "./dist/user-profile.d.ts",
      "import": "./dist/user-profile.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ngriffin_uk/polychat-utility-core": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ngriffin_uk/polychat-config": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:"
  }
}
