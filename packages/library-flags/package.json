{
  "name": "@ngriffin_uk/polychat-library-flags",
  "version": "0.1.0",
  "description": "Feature flag mechanisms for Polychat hosts: an OpenFeature-shaped evaluation contract, deterministic bucketing from a targeting key, code-defined rules with weighted splits and targeting, a Cloudflare Flagship adapter and a layered provider that lets a dashboard override code",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "polychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ngriffin_uk/polychat-utility-core": "workspace:^"
  },
  "devDependencies": {
    "@ngriffin_uk/polychat-config": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
