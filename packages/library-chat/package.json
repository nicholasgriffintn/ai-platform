      "require": "./dist/agent-trace.cjs"
    },
    "./agent-trace-display": {
      "types": "./dist/agent-trace-display.d.ts",
      "import": "./dist/agent-trace-display.js",
      "require": "./dist/agent-trace-display.cjs"
    },
    "./attachments": {
      "types": "./dist/attachments.d.ts",
      "import": "./dist/attachments.js",
      "require": "./dist/attachments.cjs"
    },
    "./branching": {
      "types": "./dist/branching.d.ts",
      "import": "./dist/branching.js",
      "require": "./dist/branching.cjs"
    },
    "./compaction-command": {
      "types": "./dist/compaction-command.d.ts",
      "import": "./dist/compaction-command.js",
      "require": "./dist/compaction-command.cjs"
    },
    "./composer-commands": {
      "types": "./dist/composer-commands.d.ts",
      "import": "./dist/composer-commands.js",
      "require": "./dist/composer-commands.cjs"
    },
