      "import": "./dist/message-utils.js",
      "require": "./dist/message-utils.cjs"
    },
    "./messages": {
      "types": "./dist/messages.d.ts",
      "import": "./dist/messages.js",
      "require": "./dist/messages.cjs"
    },
    "./model-selection": {
      "types": "./dist/model-selection.d.ts",
      "import": "./dist/model-selection.js",
      "require": "./dist/model-selection.cjs"
