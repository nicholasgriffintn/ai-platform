{
	"name": "@ngriffin_uk/polychat-library-chat",
	"version": "0.1.0",
	"description": "Reusable chat policies and conversation state helpers for Polychat",
	"license": "Apache-2.0",
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./attachments": {
			"types": "./dist/attachments.d.ts",
			"import": "./dist/attachments.js",
			"require": "./dist/attachments.cjs"
		},
		"./compaction-command": {
			"types": "./dist/compaction-command.d.ts",
			"import": "./dist/compaction-command.js",
			"require": "./dist/compaction-command.cjs"
		},
		"./conversation-storage-policy": {
			"types": "./dist/conversation-storage-policy.d.ts",
			"import": "./dist/conversation-storage-policy.js",
			"require": "./dist/conversation-storage-policy.cjs"
		},
		"./conversations": {
			"types": "./dist/conversations.d.ts",
			"import": "./dist/conversations.js",
			"require": "./dist/conversations.cjs"
		},
		"./model-selection": {
			"types": "./dist/model-selection.d.ts",
			"import": "./dist/model-selection.js",
			"require": "./dist/model-selection.cjs"
		},
		"./request-options": {
			"types": "./dist/request-options.d.ts",
			"import": "./dist/request-options.js",
			"require": "./dist/request-options.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:package": "pnpm build && node --test test/package-exports.test.mjs",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "pnpm oxlint",
		"check": "pnpm lint && pnpm format:check"
	},
	"dependencies": {
		"@ngriffin_uk/polychat-schemas": "workspace:^"
	},
	"devDependencies": {
		"@ngriffin_uk/polychat-config": "workspace:^",
		"@types/node": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"tsup": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
