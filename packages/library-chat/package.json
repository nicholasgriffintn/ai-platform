      "require": "./dist/response-stats.cjs"
    },
    "./request-options": {
      "types": "./dist/request-options.d.ts",
      "import": "./dist/request-options.js",
      "require": "./dist/request-options.cjs"
    },
    "./textarea-selection-position": {
      "types": "./dist/textarea-selection-position.d.ts",
      "import": "./dist/textarea-selection-position.js",
      "require": "./dist/textarea-selection-position.cjs"
    },
    "./tool-filters": {
      "types": "./dist/tool-filters.d.ts",
      "import": "./dist/tool-filters.js",
      "require": "./dist/tool-filters.cjs"
    },
    "./tool-results": {
      "types": "./dist/tool-results.d.ts",
