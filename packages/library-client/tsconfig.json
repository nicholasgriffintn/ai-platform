{
  "extends": "@ngriffin_uk/polychat-config/tsconfig/react-library",
  "compilerOptions": {
    "types": ["vite/client"],
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__test__/**/*",
    "src/**/__tests__/**/*",
    "src/test/**/*",
    "src/test-setup.ts"
  ],
  "references": [
    {
      "path": "../library-chat"
    },
    {
      "path": "../library-realtime"
    },
    {
      "path": "../library-surface"
    },
    {
      "path": "../schemas"
    },
    {
      "path": "../utility-core"
    }
  ]
}
