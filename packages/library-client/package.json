{
	"name": "@ngriffin_uk/polychat-library-client",
	"version": "0.1.0",
	"description": "Runtime-neutral HTTP client primitives for Polychat",
	"license": "Apache-2.0",
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./project-scope": {
			"types": "./dist/project-scope.d.ts",
			"import": "./dist/project-scope.js",
			"require": "./dist/project-scope.cjs"
		},
		"./retry": {
			"types": "./dist/retry.d.ts",
			"import": "./dist/retry.js",
			"require": "./dist/retry.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:package": "pnpm build && node --test test/package-exports.test.mjs",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "pnpm oxlint",
		"check": "pnpm lint && pnpm format:check"
	},
	"devDependencies": {
		"@ngriffin_uk/polychat-config": "workspace:^",
		"@types/node": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"tsup": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
