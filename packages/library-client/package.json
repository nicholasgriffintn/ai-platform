{
  "name": "@ngriffin_uk/polychat-library-client",
  "version": "0.2.0",
  "description": "Runtime-neutral HTTP client primitives for Polychat",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "polychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./project-scope": {
      "polychat-source": "./src/project-scope.ts",
      "types": "./dist/project-scope.d.ts",
      "import": "./dist/project-scope.js",
      "require": "./dist/project-scope.cjs"
    },
    "./retry": {
      "polychat-source": "./src/retry.ts",
      "types": "./dist/retry.d.ts",
      "import": "./dist/retry.js",
      "require": "./dist/retry.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ngriffin_uk/polychat-library-chat": "workspace:^",
    "@ngriffin_uk/polychat-library-realtime": "workspace:^",
    "@ngriffin_uk/polychat-library-surface": "workspace:^",
    "@ngriffin_uk/polychat-schemas": "workspace:^",
    "@ngriffin_uk/polychat-utility-core": "workspace:^"
  },
  "devDependencies": {
    "@ngriffin_uk/polychat-config": "workspace:^",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "8.2.2",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "zustand": "*"
  }
}
