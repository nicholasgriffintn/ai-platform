{
  "name": "@ngriffin_uk/polychat-library-tools",
  "version": "0.2.0",
  "private": false,
  "description": "Tool primitives for Polychat runtimes: executable tool definitions, provider declarations, catalogues, registries, validation and execution, mode step budgets, and permission gating",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "polychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ngriffin_uk/polychat-library-registry": "workspace:^",
    "@ngriffin_uk/polychat-schemas": "workspace:^",
    "@ngriffin_uk/polychat-utility-core": "workspace:^",
    "@ngriffin_uk/polychat-utility-server": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ngriffin_uk/polychat-config": "workspace:^",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
