{
  "name": "@assistant/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:deps && pnpm run typecheck && react-router build",
    "build:deps": "pnpm --filter \"@assistant/app^...\" --if-present build",
    "build:e2e": "react-router build --mode e2e",
    "check": "pnpm lint && pnpm format:check",
    "ci:test": "pnpm run coverage",
    "coverage": "vitest run --coverage",
    "deploy": "pnpm run build && wrangler deploy --minify",
    "dev": "react-router dev",
    "dev:scan": "pnpm dev & npx react-scan@latest localhost:5173",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "pnpm oxlint",
    "serve:e2e": "wrangler dev --config tests/e2e/runtime/app-wrangler.jsonc --env-file tests/e2e/runtime/app.env --port 5173 --log-level warn",
    "start": "wrangler dev",
    "sync": "npx cap sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc -b",
    "watch": "react-router build --watch",
    "wrangler:dev": "pnpm run build && wrangler dev --remote"
  },
  "dependencies": {
