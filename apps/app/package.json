{
  "name": "@assistant/app",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:deps && pnpm run typecheck && react-router build",
    "build:analyse": "ANALYSE_BUNDLE=true react-router build",
    "build:deps": "vp run --filter=\"@assistant/app^...\" build",
    "build:e2e": "pnpm run build:deps && react-router build --mode e2e",
    "check": "pnpm lint && pnpm format:check",
    "coverage": "vitest run --coverage",
    "deploy": "pnpm run build && wrangler deploy --minify",
    "dev": "react-router dev",
    "dev:scan": "pnpm dev & npx react-scan@latest localhost:5173",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "pnpm oxlint",
    "serve:e2e": "wrangler dev --config tests/e2e/runtime/app-wrangler.jsonc --env-file tests/e2e/runtime/app.env --port ${POLYCHAT_E2E_APP_PORT:-5173} --log-level warn",
    "start": "wrangler dev",
    "sync": "npx cap sync",
    "test:watch": "vitest",
    "typecheck": "pnpm typegen && tsc -b",
    "typegen": "react-router typegen",
    "watch": "react-router build --watch",
    "wrangler:dev": "pnpm run build && wrangler dev --remote"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.87",
