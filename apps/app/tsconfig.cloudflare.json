{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "src/**/*",
    "src/**/.server/**/*",
    "src/**/.client/**/*",
    "workers/**/*",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.cloudflare.tsbuildinfo",
    "composite": true,
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["@cloudflare/workers-types", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "src/*": ["./src/*"],
      "~/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "references": [
    {
      "path": "../../packages/ai-prompts"
    },
    {
      "path": "../../packages/component-account"
    },
    {
      "path": "../../packages/component-capabilities"
    },
    {
      "path": "../../packages/component-content"
    },
    {
      "path": "../../packages/component-conversation"
    },
    {
      "path": "../../packages/component-experiences"
    },
    {
      "path": "../../packages/component-models"
    },
    {
      "path": "../../packages/component-navigation"
    },
    {
      "path": "../../packages/component-shell"
    },
    {
      "path": "../../packages/component-ui"
    },
    {
      "path": "../../packages/component-workspaces"
    },
    {
      "path": "../../packages/library-chat"
    },
    {
      "path": "../../packages/library-client"
    },
    {
      "path": "../../packages/library-react"
    },
    {
      "path": "../../packages/library-realtime"
    },
    {
      "path": "../../packages/library-surface"
    },
    {
      "path": "../../packages/schemas"
    },
    {
      "path": "../../packages/utility-core"
    },
    {
      "path": "../../packages/utility-react"
    }
  ]
}
