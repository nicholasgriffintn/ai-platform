{
  "name": "polychat-e2e-api",
  "main": "../../../../api/src/index.ts",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.md"
      ],
      "fallthrough": true,
    },
  ],
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
}
