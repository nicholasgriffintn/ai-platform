{
  "name": "@assistant/api",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "scripts": {
    "build": "pnpm run build:deps",
    "build:deps": "vp run --filter=\"@assistant/api^...\" build",
    "cf-typegen": "wrangler types",
    "ci:test": "pnpm run coverage",
    "coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply personal-assistant --local",
    "db:migrate:preview": "wrangler d1 migrations apply personal-assistant-preview --remote",
    "db:migrate:prod": "wrangler d1 migrations apply personal-assistant --remote",
    "db:seed:local": "node ./scripts/db-seed.mjs --target local",
    "db:seed:preview": "node ./scripts/db-seed.mjs --target preview",
    "db:studio:local": "DB_LOCAL_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) drizzle-kit studio",
    "db:studio:preview": "NODE_ENV='preview' drizzle-kit studio",
    "db:studio:prod": "drizzle-kit studio",
    "db:up": "drizzle-kit up:sqlite",
    "deploy": "pnpm build && pnpm typecheck && wrangler deploy src/index.ts --name=assistant",
    "dev": "WRANGLER_BUILD_CONDITIONS=polychat-source,workerd,worker,browser wrangler dev src/index.ts",
    "dev:pass": "WRANGLER_BUILD_CONDITIONS=polychat-source,workerd,worker,browser CLOUDFLARE_INCLUDE_PROCESS_ENV=true pass-cli run --env-file .dev.vars -- wrangler dev src/index.ts --env-file .dev.vars",
    "start": "wrangler dev src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/standard-validator": "0.4.0",
    "@hono/zod-validator": "0.9.1",
    "@ngriffin_uk/auth-core": "^0.5.1",
    "@ngriffin_uk/auth-encoding": "^0.2.4",
    "@ngriffin_uk/auth-jwt": "^2.0.0",
    "@ngriffin_uk/auth-magic-link": "^0.0.6",
    "@ngriffin_uk/auth-oauth2": "^4.0.1",
    "@ngriffin_uk/auth-protocol": "^0.1.1",
    "@ngriffin_uk/auth-provider-apple": "^4.0.1",
    "@ngriffin_uk/auth-provider-github": "^4.0.0",
    "@ngriffin_uk/auth-webauthn": "^0.4.6",
    "@ngriffin_uk/polychat-ai-agents": "workspace:^",
    "@ngriffin_uk/polychat-ai-billing": "workspace:^",
    "@ngriffin_uk/polychat-ai-experiments": "workspace:^",
    "@ngriffin_uk/polychat-ai-functions": "workspace:^",
    "@ngriffin_uk/polychat-ai-integrations": "workspace:^",
    "@ngriffin_uk/polychat-ai-models": "workspace:^",
    "@ngriffin_uk/polychat-ai-prompts": "workspace:^",
    "@ngriffin_uk/polychat-ai-providers": "workspace:^",
    "@ngriffin_uk/polychat-ai-sandbox": "workspace:^",
    "@ngriffin_uk/polychat-ai-skills": "workspace:^",
    "@ngriffin_uk/polychat-ai-telemetry": "workspace:^",
    "@ngriffin_uk/polychat-ai-workflows": "workspace:^",
    "@ngriffin_uk/polychat-library-flags": "workspace:^",
    "@ngriffin_uk/polychat-library-goals": "workspace:^",
    "@ngriffin_uk/polychat-library-interactions": "workspace:^",
    "@ngriffin_uk/polychat-library-registry": "workspace:^",
    "@ngriffin_uk/polychat-library-sandbox": "workspace:^",
    "@ngriffin_uk/polychat-library-skills-catalogue": "workspace:^",
    "@ngriffin_uk/polychat-library-tasks": "workspace:^",
    "@ngriffin_uk/polychat-library-tools": "workspace:^",
    "@ngriffin_uk/polychat-schemas": "workspace:^",
    "@ngriffin_uk/polychat-utility-core": "workspace:^",
    "@ngriffin_uk/polychat-utility-server": "workspace:^",
    "@scalar/hono-api-reference": "0.12.1",
    "@sentry/cloudflare": "10.74.0",
    "@tsndr/cloudflare-worker-jwt": "3.2.3",
    "agents": "0.23.0",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "hono-openapi": "1.3.2",
    "isbot": "5.2.2",
    "stripe": "22.6.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.10",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
