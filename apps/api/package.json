{
  "name": "@assistant/api",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "scripts": {
    "build": "pnpm --filter @ngriffin_uk/polychat-schemas build",
    "cf-typegen": "wrangler types",
    "ci:test": "pnpm run coverage",
    "connectors:sync": "node ./scripts/sync-composio-toolkit-manifest.mjs",
    "coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply personal-assistant --local",
    "db:migrate:preview": "wrangler d1 migrations apply personal-assistant-preview --remote",
    "db:migrate:prod": "wrangler d1 migrations apply personal-assistant --remote",
    "db:studio:local": "DB_LOCAL_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) drizzle-kit studio",
    "db:studio:preview": "NODE_ENV='preview' drizzle-kit studio",
    "db:studio:prod": "drizzle-kit studio",
    "db:sync:preview": "bash ./scripts/db-sync-preview.sh",
    "db:up": "drizzle-kit up:sqlite",
    "deploy": "pnpm build && pnpm typecheck && wrangler deploy src/index.ts --name=assistant",
    "dev": "pnpm --filter @ngriffin_uk/polychat-schemas build && wrangler dev src/index.ts",
    "models:sync": "node ./scripts/sync-models-dev.mjs",
    "start": "wrangler dev src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/standard-validator": "0.4.0",
    "@hono/zod-validator": "0.9.0",
    "@ngriffin_uk/auth-core": "^0.5.1",
    "@ngriffin_uk/auth-encoding": "^0.2.4",
    "@ngriffin_uk/auth-jwt": "^2.0.0",
    "@ngriffin_uk/auth-magic-link": "^0.0.6",
    "@ngriffin_uk/auth-oauth2": "^4.0.1",
    "@ngriffin_uk/auth-protocol": "^0.1.1",
    "@ngriffin_uk/auth-provider-apple": "^4.0.1",
    "@ngriffin_uk/auth-provider-github": "^4.0.0",
    "@ngriffin_uk/auth-webauthn": "^0.4.6",
    "@ngriffin_uk/polychat-library-agent-core": "workspace:^",
    "@ngriffin_uk/polychat-library-registry": "workspace:^",
    "@ngriffin_uk/polychat-library-tool-runtime": "workspace:^",
    "@ngriffin_uk/polychat-schemas": "workspace:^",
    "@scalar/hono-api-reference": "0.11.13",
    "@sentry/cloudflare": "10.70.0",
    "@tsndr/cloudflare-worker-jwt": "3.2.2",
    "agents": "0.20.1",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.1",
    "hono-openapi": "1.3.1",
    "isbot": "5.2.1",
    "posthog-node": "^5.48.1",
    "stripe": "22.5.0",
    "yaml": "2.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.10",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
