{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "verbatimModuleSyntax": false,
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "noImplicitAny": false,
    "noImplicitThis": true,
    "strictNullChecks": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "Bundler",
    "module": "es2022",
    "noEmit": true,
    "lib": ["DOM", "es2022"],
    "types": ["@types/node", "@cloudflare/workers-types/experimental"],
    "paths": {
      "~/*": ["./src/*"]
    },
    "composite": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "references": [
