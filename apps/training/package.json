{
	"name": "@assistant/training",
	"version": "0.0.1",
	"private": true,
	"description": "Training Worker service for training and deployment jobs",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsc",
		"dev": "pnpm --filter @ngriffin_uk/polychat-schemas build && wrangler dev",
		"start": "pnpm --filter @ngriffin_uk/polychat-schemas build && wrangler dev",
		"typecheck": "pnpm --filter @ngriffin_uk/polychat-schemas build && tsc --noEmit",
		"lint": "pnpm oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"check": "pnpm lint && pnpm format:check",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"ci:test": "pnpm run coverage",
		"deploy": "pnpm --filter @ngriffin_uk/polychat-schemas build && pnpm typecheck && wrangler deploy"
	},
	"dependencies": {
		"@aws-sdk/client-bedrock": "3.1106.0",
		"@ngriffin_uk/polychat-schemas": "workspace:^",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:",
		"@types/node": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
