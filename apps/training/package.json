{
  "name": "@assistant/training",
  "version": "0.0.1",
  "private": true,
  "description": "Training Worker service for training and deployment jobs",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "build:deps": "pnpm --filter \"@assistant/training^...\" --if-present build",
    "ci:test": "pnpm run coverage",
    "coverage": "vitest run --coverage",
    "deploy": "pnpm run build:deps && pnpm typecheck && wrangler deploy",
    "dev": "WRANGLER_BUILD_CONDITIONS=polychat-source,workerd,worker,browser wrangler dev",
    "start": "pnpm --filter @ngriffin_uk/polychat-schemas build && wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "3.1117.0",
    "@ngriffin_uk/polychat-schemas": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
