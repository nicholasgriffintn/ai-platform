{
  "name": "@assistant/sandbox-worker",
  "version": "0.0.2",
  "private": true,
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "scripts": {
    "build:deps": "vp run --filter=\"@assistant/sandbox-worker^...\" build",
    "cf-typegen": "wrangler types",
    "ci:test": "pnpm run coverage",
    "coverage": "vitest run --coverage",
    "deploy": "pnpm run build:deps && pnpm typecheck && wrangler deploy",
    "dev": "WRANGLER_BUILD_CONDITIONS=polychat-source,workerd,worker,browser wrangler dev src/index.ts",
    "start": "vp run --filter=@ngriffin_uk/polychat-schemas build && wrangler dev src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.9",
    "@ngriffin_uk/auth-jwt": "^2.0.0",
    "@ngriffin_uk/polychat-ai-agents": "workspace:^",
    "@ngriffin_uk/polychat-ai-prompts": "workspace:^",
    "@ngriffin_uk/polychat-library-client": "workspace:^",
    "@ngriffin_uk/polychat-library-interactions": "workspace:^",
    "@ngriffin_uk/polychat-library-sandbox": "workspace:^",
    "@ngriffin_uk/polychat-library-tools": "workspace:^",
    "@ngriffin_uk/polychat-schemas": "workspace:^",
    "@ngriffin_uk/polychat-utility-core": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
