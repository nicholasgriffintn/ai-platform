{
  "name": "assistant-sandbox-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "*.preview.polychat.app/*",
      "zone_name": "polychat.app"
    },
    {
      "pattern": "*.computer.polychat.app/*",
      "zone_name": "polychat.app"
    }
  ],
  "dev": {
    "port": 8788
  },
  "vars": {
    "APP_BASE_URL": "https://polychat.app",
    "ENV": "production",
    "SANDBOX_PREVIEW_HOST": "preview.polychat.app",
    "COMPUTER_SCREEN_HOST": "computer.polychat.app"
  },
  "placement": {
    "mode": "smart"
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false
    }
  },
  "services": [
    {
      "binding": "POLYCHAT_API",
      "service": "assistant"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "assistant-private-assets",
      "preview_bucket_name": "assistant-private-assets",
      "remote": true
    }
  ],
  "containers": [
    {
      "class_name": "Workspace",
      "scheduling_policy": "durable_object",
      "images": {
        "code": {
          "dockerfile": "./Dockerfile"
        }
      }
    },
    {
      "class_name": "Computer",
      "scheduling_policy": "durable_object",
      "images": {
        "browser": {
          "dockerfile": "./computer/Dockerfile",
          "build_context": "./computer"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Workspace",
        "name": "WORKSPACE"
      },
      {
        "class_name": "Computer",
        "name": "COMPUTER"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Workspace", "Computer"],
      "deleted_classes": ["Sandbox"]
    }
  ]
}
