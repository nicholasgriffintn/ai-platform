{
  "name": "assistant-sandbox-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "*.preview.polychat.app/*",
      "zone_name": "polychat.app"
    }
  ],
  "dev": {
    "port": 8788
  },
  "vars": {
    "APP_BASE_URL": "https://polychat.app",
    "ENV": "production",
    "SANDBOX_TRANSPORT": "rpc",
    "SANDBOX_INSTANCE_TYPE": "basic",
    "SANDBOX_PREVIEW_HOST": "preview.polychat.app"
  },
  "placement": {
    "mode": "smart"
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false
    }
  },
  "services": [
    {
      "binding": "POLYCHAT_API",
      "service": "assistant"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "assistant-private-assets",
      "preview_bucket_name": "assistant-private-assets",
      "remote": true
    }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox"]
    }
  ]
}
