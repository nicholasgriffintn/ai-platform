{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polychat",
  "version": "0.1.0",
  "identifier": "uk.co.nicholasgriffin.polychat.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:renderer",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Polychat",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://assistant-assets.nickgriffin.uk; font-src 'self'; media-src 'self' blob: https://assistant-assets.nickgriffin.uk; connect-src 'self' ipc: http://ipc.localhost https://api.polychat.app wss://api.polychat.app; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": true,
      "pubkey": "",
      "endpoints": [
        "https://api.polychat.app/desktop/releases/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
