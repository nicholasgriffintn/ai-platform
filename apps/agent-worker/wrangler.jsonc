{
  "name": "assistant-agent-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "port": 8789,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "vars": {
    "POLYCHAT_API_URL": "https://api.polychat.app",
  },
  "services": [
    {
      "binding": "POLYCHAT_API",
      "service": "assistant",
    },
  ],
  "containers": [
    {
      "class_name": "HermesAgent",
      "scheduling_policy": "durable_object",
      "images": {
        "hermes": {
          "dockerfile": "./hermes/Dockerfile",
          "build_context": "./hermes",
        },
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "PiAgent", "name": "PI_AGENT" },
      { "class_name": "OpenCodeAgent", "name": "OPENCODE_AGENT" },
      { "class_name": "HermesAgent", "name": "HERMES_AGENT" },
      {
        "class_name": "Workspace",
        "name": "WORKSPACE",
        "script_name": "assistant-sandbox-worker",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentHost"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PiAgent", "OpenCodeAgent", "HermesAgent"],
      "deleted_classes": ["AgentHost"],
    },
  ],
}
