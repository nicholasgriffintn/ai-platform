{
  "name": "assistant-agent-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SANDBOX_TRANSPORT": "rpc",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "assistant-private-assets",
      "preview_bucket_name": "assistant-private-assets",
      "remote": true,
    },
  ],
  "services": [
    {
      "binding": "POLYCHAT_API",
      "service": "assistant",
    },
  ],
  "containers": [
    {
      "class_name": "AgentHost",
      "image": "./agent-host/Dockerfile",
      "instance_type": "standard-1",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "AgentHost",
        "name": "AgentHost",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentHost"],
    },
  ],
}
