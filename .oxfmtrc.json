{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "objectWrap": "preserve",
  "sortImports": {
    "newlinesBetween": true,
    "sortSideEffects": false
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortTailwindcss": {
    "stylesheet": "./apps/app/src/styles/index.css",
    "functions": ["clsx", "cn", "cva", "twMerge"]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.wrangler/**",
    "**/generated/**",
    "**/target/**",
    "apps/api/src/data-model/models/**",
    "apps/api/src/openapi/content/**"
  ]
}
