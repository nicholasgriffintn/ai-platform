{
  "name": "@assistant/root",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:e2e": "pnpm build:packages && pnpm --filter @assistant/app build:e2e && pnpm build:e2e:sandbox",
    "build:e2e:sandbox": "node apps/app/tests/e2e/runtime/build-sandbox.mjs",
    "build:mobile": "sh scripts/xcodebuild-mobile.sh release",
    "build:packages": "vp run --filter=\"./packages/**\" build",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-native-versions.mjs",
    "check": "pnpm lint && pnpm format:check",
    "ci:test": "pnpm run coverage",
    "coverage": "vitest run --coverage",
    "deploy": "pnpm --filter @assistant/api --filter @assistant/app deploy",
    "deploy:api": "pnpm --filter @assistant/api deploy",
    "deploy:app": "pnpm --filter @assistant/app deploy",
    "deploy:training": "pnpm --filter @assistant/training deploy",
    "dev": "vp run --parallel --log labeled -F @assistant/api -F @assistant/app dev",
    "dev:api": "pnpm --filter @assistant/api dev",
    "dev:app": "pnpm --filter @assistant/app dev",
    "dev:mobile": "sh scripts/xcodebuild-mobile.sh build",
    "dev:training": "pnpm --filter @assistant/training dev",
    "fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:monorepo": "sherif",
    "refresh:mobile-model-fixture": "node scripts/refresh-mobile-model-fixture.mjs",
    "release:check": "pnpm check && pnpm typecheck && pnpm test && pnpm test:e2e:release && pnpm build:packages && pnpm audit --audit-level high",
    "release:plan": "node scripts/app-releases.mjs",
    "release:publish": "pnpm release:check && changeset publish",
    "test": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.ts --tsconfig=tsconfig.playwright.json",
    "test:e2e:container": "node scripts/test-e2e-container.mjs",
    "test:e2e:release": "PVC_ENVIRONMENT=release pnpm test:e2e",
    "test:e2e:smoke": "PVC_ENVIRONMENT=smoke pnpm test:e2e apps/app/tests/e2e/smoke",
    "test:mobile": "sh scripts/xcodebuild-mobile.sh test",
    "test:watch": "vitest",
    "typecheck": "pnpm build:packages && vp run --cache --filter=\"./packages/**\" --filter=\"./apps/**\" typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@playwright/test": "1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "^17.4.2",
    "miniflare": "5.20260801.1-alpha",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright-visual-cloud": "0.1.3",
    "sherif": "^1.11.1",
    "vite-plus": "0.3.0",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.3.4"
}
