{
	"name": "@assistant/root",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build:packages": "pnpm -r --filter './packages/**' --if-present build",
		"pack:check": "node scripts/check-package-packs.mjs",
		"format": "pnpm -r format",
		"lint": "pnpm lint:monorepo && pnpm -r lint",
		"lint:monorepo": "sherif && pnpm check:packages",
		"check:packages": "node scripts/check-package-boundaries.mjs",
		"check": "pnpm check:packages && pnpm -r check",
		"typecheck": "pnpm build:packages && pnpm -r --workspace-concurrency=1 typecheck",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"ci:test": "pnpm run coverage",
		"dev:api": "pnpm --filter @assistant/api dev",
		"dev:app": "pnpm --filter @assistant/app dev",
		"dev:training": "pnpm --filter @assistant/training dev",
		"dev": "pnpm --filter @assistant/api --filter @assistant/app dev",
		"deploy:api": "pnpm --filter @assistant/api deploy",
		"deploy:app": "pnpm --filter @assistant/app deploy",
		"deploy:training": "pnpm --filter @assistant/training deploy",
		"deploy": "pnpm --filter @assistant/api --filter @assistant/app deploy",
		"test:e2e": "playwright test --config=playwright.config.ts --tsconfig=tsconfig.playwright.json",
		"dev:mobile": "sh scripts/xcodebuild-mobile.sh build",
		"build:mobile": "sh scripts/xcodebuild-mobile.sh release",
		"test:mobile": "sh scripts/xcodebuild-mobile.sh test",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"release:check": "pnpm check:packages && pnpm check && pnpm typecheck && pnpm test && pnpm build:packages && pnpm -r --if-present test:package && pnpm pack:check && pnpm audit --audit-level high",
		"release:publish": "pnpm release:check && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@playwright/test": "1.62.1",
		"@types/node": "catalog:",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-v8": "4.1.10",
		"sherif": "^1.11.1",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@11.20.0"
}
