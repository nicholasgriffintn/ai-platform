{
  "name": "@assistant/root",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:e2e": "pnpm build:packages && pnpm --filter @assistant/app build:e2e",
    "build:mobile": "sh scripts/xcodebuild-mobile.sh release",
    "build:packages": "pnpm -r --filter './packages/**' --if-present build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "check": "pnpm lint && pnpm format:check && pnpm -r --if-present check",
    "ci:test": "pnpm run coverage",
    "coverage": "vitest run --coverage",
    "deploy": "pnpm --filter @assistant/api --filter @assistant/app deploy",
    "deploy:api": "pnpm --filter @assistant/api deploy",
    "deploy:app": "pnpm --filter @assistant/app deploy",
    "deploy:training": "pnpm --filter @assistant/training deploy",
    "dev": "pnpm --filter @assistant/api --filter @assistant/app dev",
    "dev:api": "pnpm --filter @assistant/api dev",
    "dev:app": "pnpm --filter @assistant/app dev",
    "dev:mobile": "sh scripts/xcodebuild-mobile.sh build",
    "dev:training": "pnpm --filter @assistant/training dev",
    "fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:monorepo": "sherif",
    "release:check": "pnpm check && pnpm typecheck && pnpm test && pnpm test:e2e:release && pnpm build:packages && pnpm -r --if-present test:package && pnpm audit --audit-level high",
    "release:publish": "pnpm release:check && changeset publish",
    "test": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.ts --tsconfig=tsconfig.playwright.json",
    "test:e2e:release": "PVC_ENVIRONMENT=release pnpm test:e2e",
    "test:e2e:smoke": "PVC_ENVIRONMENT=smoke pnpm test:e2e apps/app/tests/e2e/smoke",
    "test:mobile": "sh scripts/xcodebuild-mobile.sh test",
    "test:watch": "vitest",
    "typecheck": "pnpm build:packages && pnpm -r --workspace-concurrency=1 typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "^17.4.2",
    "miniflare": "5.20260801.1-alpha",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright-visual-cloud": "0.1.3",
    "sherif": "^1.11.1",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.20.0"
}
